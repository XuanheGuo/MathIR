{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathir.org/schema/mathir-document-0.1.0.schema.json",
  "title": "MathIR Document v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mathirVersion",
    "documentId",
    "kind",
    "declarations",
    "expressions",
    "statements",
    "steps",
    "assumptions",
    "goals"
  ],
  "properties": {
    "mathirVersion": { "type": "string" },
    "documentId": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["problem", "solution", "combined"] },
    "metadata": { "type": "object" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "declarations": { "type": "array", "items": { "$ref": "#/$defs/declaration" } },
    "expressions": { "type": "array", "items": { "$ref": "#/$defs/expression" } },
    "statements": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "assumptions": { "$ref": "#/$defs/ids" },
    "goals": { "$ref": "#/$defs/ids" },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "start", "end"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "domain": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["natural", "integer", "rational", "real", "boolean"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "set" },
            "elementDomain": { "$ref": "#/$defs/domain" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "unknown" }, "description": { "type": "string" } }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mediaType"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "mediaType": { "enum": ["text/plain", "text/markdown", "application/x-latex"] },
        "content": { "type": "string" },
        "uri": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "symbolDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "symbol" },
        "name": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/domain" },
        "sourceSpan": { "$ref": "#/$defs/span" }
      }
    },
    "functionDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "parameters"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "function" },
        "name": { "type": "string", "minLength": 1 },
        "parameters": { "$ref": "#/$defs/ids" },
        "domain": { "type": "array", "items": { "$ref": "#/$defs/domain" } },
        "codomain": { "$ref": "#/$defs/domain" },
        "sourceSpan": { "$ref": "#/$defs/span" }
      }
    },
    "declaration": {
      "oneOf": [{ "$ref": "#/$defs/symbolDeclaration" }, { "$ref": "#/$defs/functionDeclaration" }]
    },
    "expressionCommon": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceSpan": { "$ref": "#/$defs/span" },
        "inferredDomain": { "$ref": "#/$defs/domain" }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "value"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "number" },
            "value": { "type": "string" },
            "numberKind": { "enum": ["integer", "decimal", "rational"] },
            "sourceSpan": { "$ref": "#/$defs/span" },
            "inferredDomain": { "$ref": "#/$defs/domain" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "declarationId"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "symbol" },
            "declarationId": { "$ref": "#/$defs/id" },
            "sourceSpan": { "$ref": "#/$defs/span" },
            "inferredDomain": { "$ref": "#/$defs/domain" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "operator", "operand"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "unary" },
            "operator": { "enum": ["negate", "absolute", "not"] },
            "operand": { "$ref": "#/$defs/id" },
            "sourceSpan": { "$ref": "#/$defs/span" },
            "inferredDomain": { "$ref": "#/$defs/domain" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "operator", "left", "right"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "binary" },
            "operator": { "enum": ["subtract", "divide", "power", "implies", "iff"] },
            "left": { "$ref": "#/$defs/id" },
            "right": { "$ref": "#/$defs/id" },
            "sourceSpan": { "$ref": "#/$defs/span" },
            "inferredDomain": { "$ref": "#/$defs/domain" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "operator", "operands"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "nary" },
            "operator": { "enum": ["add", "multiply", "and", "or"] },
            "operands": { "$ref": "#/$defs/ids" },
            "sourceSpan": { "$ref": "#/$defs/span" },
            "inferredDomain": { "$ref": "#/$defs/domain" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "functionDeclarationId", "arguments"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "function_call" },
            "functionDeclarationId": { "$ref": "#/$defs/id" },
            "arguments": { "$ref": "#/$defs/ids" },
            "sourceSpan": { "$ref": "#/$defs/span" },
            "inferredDomain": { "$ref": "#/$defs/domain" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "branches"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "piecewise" },
            "branches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["condition", "value"],
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/id",
                    "description": "Statement ID selecting this branch."
                  },
                  "value": {
                    "$ref": "#/$defs/id",
                    "description": "Expression ID produced by this branch."
                  }
                }
              }
            },
            "otherwise": { "$ref": "#/$defs/id" },
            "sourceSpan": { "$ref": "#/$defs/span" },
            "inferredDomain": { "$ref": "#/$defs/domain" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "raw", "reason"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "unparsed" },
            "raw": { "type": "string" },
            "reason": {
              "enum": ["unsupported_syntax", "ambiguous", "incomplete", "parser_failure"]
            },
            "candidates": { "$ref": "#/$defs/ids" },
            "sourceSpan": { "$ref": "#/$defs/span" },
            "inferredDomain": { "$ref": "#/$defs/domain" }
          }
        }
      ]
    },
    "statement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "relation", "left", "right"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "relation" },
            "relation": {
              "enum": [
                "equal",
                "not_equal",
                "less_than",
                "less_than_or_equal",
                "greater_than",
                "greater_than_or_equal",
                "element_of",
                "subset_of"
              ]
            },
            "left": { "$ref": "#/$defs/id" },
            "right": { "$ref": "#/$defs/id" },
            "sourceSpan": { "$ref": "#/$defs/span" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "predicate", "arguments"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "predicate" },
            "predicate": { "enum": ["defined", "nonzero", "positive", "nonnegative"] },
            "arguments": { "$ref": "#/$defs/ids" },
            "sourceSpan": { "$ref": "#/$defs/span" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "connective", "operands"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "compound" },
            "connective": { "enum": ["and", "or", "not", "implies", "iff"] },
            "operands": { "$ref": "#/$defs/ids" },
            "sourceSpan": { "$ref": "#/$defs/span" }
          }
        }
      ]
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "equivalence" },
            "name": {
              "enum": [
                "simplification",
                "algebraic_rearrangement",
                "substitution",
                "definition_expansion"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "implication" },
            "name": {
              "enum": ["apply_inequality", "case_analysis", "modus_ponens", "specialization"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "assertion" },
            "name": { "enum": ["given", "derived", "external_result"] },
            "reference": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "unknown" }, "raw": { "type": "string" } }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "premises", "conclusion", "dependencies", "rule", "sideConditions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "premises": { "$ref": "#/$defs/ids" },
        "conclusion": { "$ref": "#/$defs/id" },
        "dependencies": { "$ref": "#/$defs/ids" },
        "rule": { "$ref": "#/$defs/rule" },
        "sideConditions": { "$ref": "#/$defs/ids" },
        "status": { "enum": ["parsed", "partial", "unparsed"] },
        "confidence": { "type": "number" },
        "sourceSpan": { "$ref": "#/$defs/span" }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "severity", "code", "message"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["expression", "statement", "step"] },
            "id": { "$ref": "#/$defs/id" }
          }
        },
        "severity": { "enum": ["info", "warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "sourceSpan": { "$ref": "#/$defs/span" }
      }
    }
  }
}
